# Copy to .env (compose reads it automatically) and change the password.
# Required:
APP_PASSWORD=change-me-please
# Stable session-cookie key: `openssl rand -hex 32` (unset = random per boot)
APP_SECRET=

# Postgres (the `db` service). Change the password on a public box.
POSTGRES_USER=suite
POSTGRES_PASSWORD=suite
POSTGRES_DB=suite

# Redis (the `redis` service). Compose wires REDIS_URL itself; shown for clarity.
# REDIS_URL=redis://redis:6379/0

# Behaviour
# auto (default) = Secure cookie exactly when the browser is on https. Do not
# set 1 unless you are certain every visitor is on https: a Secure cookie sent
# over plain http is silently dropped by the browser, so login "does nothing".
COOKIE_SECURE=auto
# Behind Traefik/Coolify the app is reached over plain http and must trust
# X-Forwarded-Proto / X-Forwarded-Host. 0 only if the container is exposed bare.
TRUST_PROXY=1
# Leave 0 while the proxy redirects http→https (two redirectors = loops).
FORCE_HTTPS=0
# The public origin users type, e.g. https://s2c.example.com (optional).
PUBLIC_URL=
# Only for separate frontend and API origins: comma-separated HTTPS origins.
CORS_ORIGINS=
AUTOLABEL=1
MAX_UPLOAD_MB=24
SUITE_MAX_JOBS=1         # concurrent jobs PER PROCESS; 1 is right for 4 cores

# ---- separate worker containers -------------------------------------------
# inprocess (default) = the app container runs jobs itself.
# To move long jobs out of the web process:
#   1. SUITE_RUN_JOBS=worker        <- here, so `suite` only enqueues
#   2. docker compose --profile worker up -d
#   3. --scale worker=3 to add replicas (each claims jobs exclusively)
SUITE_RUN_JOBS=inprocess
SUITE_MAX_QUEUED=50      # refuse to enqueue beyond this rather than grow forever
SUITE_CLAIM_TTL=300      # a job whose owner stopped heartbeating this long may
                         # be taken over; must exceed SUITE_HEARTBEAT by a lot
SUITE_HEARTBEAT=30       # how often a running job refreshes its claim
SUITE_MAX_ATTEMPTS=3     # then give up, instead of retrying a hopeless job
SUITE_WORKER_DRAIN_TIMEOUT=900

# ---- security -------------------------------------------------------------
# Networks allowed to set X-Forwarded-For. The login throttle only trusts the
# header from these; everywhere else the peer address is used, so a spoofed
# header cannot rotate past the limit. Empty = trust nothing.
TRUSTED_PROXY_CIDRS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
# 0 (default) = refuse to start without APP_PASSWORD. 1 = deliberately open
# instance; the UI shows a banner. Only on a trusted network.
ALLOW_ANONYMOUS=0
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
YOLO_OFFLINE=1
S2C_DECODE_MODE=auto
SUITE_PORT=8889
